---
// src/components/Navbar.astro
---

<header class="navbar">
  <div class="logo-container">
    <a href="#home">
      <img 
        src="/uncut-logo-new.avif" 
        alt="UNCUT ELECTRO-MECHANICAL ENGINEERING Logo" 
        class="logo-img"
      />
    </a>
  </div>
  <nav class="nav-links">
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#about">About Us</a></li>
      <!-- CTA Button with explicit black text -->
      <li><a href="#contact" class="cta-button">Get a Quote</a></li>
    </ul>
  </nav>
</header>

<style>
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2.5rem;
    background-color: #000000;
    color: #ffffff;
    border-bottom: 2px solid #FF7F00; /* Orange border on bottom */
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .logo-container img {
    width: 220px;
    height: 220px;
    max-height: 220px;
    object-fit: contain;
    display: block;
  }

  .nav-links ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-family: sans-serif;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .nav-links a:hover {
    color: #FF7F00;
  }

  /* Specific styling for buttons requiring black text */
  .cta-button {
    background-color: #FF7F00; /* Orange background */
    color: #000000 !important;   /* Strictly black text */
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    transition: background-color 0.3s ease, opacity 0.3s ease;
  }

  .cta-button:hover {
    background-color: #e67300; /* Slightly darker orange on hover */
    color: #000000 !important;
  }

  /* Mobile-only adjustments (Screens 768px wide or smaller) */
  @media (max-width: 768px) {
    .navbar {
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.5rem 1rem 0.75rem 1rem; /* Reduced padding to collapse navbar height */
      border-bottom: 2px solid #FF7F00;  /* Native border sits at the true bottom */
    }

    /* Pulls logo up and shrinks empty spacing inside the image box */
    .logo-container img {
      margin-top: -40px;
      margin-bottom: -35px;
    }

    /* Pulls menu row up cleanly without leaving leftover height */
    .nav-links {
      margin-top: -15px;
    }

    .nav-links ul {
      gap: 1.25rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>