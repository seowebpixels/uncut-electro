---
// src/components/Navbar.astro
---

<header class="navbar">
  <div class="logo-container">
    <a href="#home">
      <img 
        src="/uncut-logo-new.avif" 
        alt="UNCUT ELECTRO-MECHANICAL ENGINEERING Logo" 
        class="logo-img"
      />
    </a>
  </div>
  <nav class="nav-links">
    <ul>
      <li><a href="#home">Home</a></li>
      <li><a href="#services">Services</a></li>
      <li><a href="#about">About Us</a></li>
      <!-- CTA Button with explicit black text -->
      <li><a href="#contact" class="cta-button">Get a Quote</a></li>
    </ul>
  </nav>
</header>

<style>
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 2.5rem;
    background-color: #000000;
    color: #ffffff;
    border-bottom: 2px solid #FF7F00; /* Orange border on desktop */
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .logo-container img {
    width: 220px;
    height: 220px;
    max-height: 220px;
    object-fit: contain;
    display: block;
  }

  .nav-links ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    font-family: sans-serif;
    text-transform: uppercase;
    font-size: 0.85rem;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .nav-links a:hover {
    color: #FF7F00;
  }

  /* Specific styling for buttons requiring black text */
  .cta-button {
    background-color: #FF7F00; /* Orange background */
    color: #000000 !important;   /* Strictly black text */
    padding: 0.6rem 1.2rem;
    border-radius: 4px;
    transition: background-color 0.3s ease, opacity 0.3s ease;
  }

  .cta-button:hover {
    background-color: #e67300; /* Slightly darker orange on hover */
    color: #000000 !important;
  }

  /* Mobile-only adjustments (Screens 768px wide or smaller) */
  @media (max-width: 768px) {
    .navbar {
      flex-direction: column;
      gap: 1rem;
      padding: 1rem;
      border-bottom: none; /* Remove standard border on mobile */
      position: relative;  /* Container reference for line positioning */
    }

    /* Create the custom orange line moved up by 50px */
    .navbar::after {
      content: '';
      position: absolute;
      bottom: 50px; /* Positions line 50px up from the bottom of the navbar */
      left: 0;
      right: 0;
      height: 2px;
      background-color: #FF7F00;
    }

    /* Shifts the logo up by 60px on mobile */
    .logo-container img {
      transform: translateY(-60px);
    }

    /* Shifts the entire menu row up by 60px on mobile */
    .nav-links {
      transform: translateY(-60px);
    }

    .nav-links ul {
      gap: 1.25rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>