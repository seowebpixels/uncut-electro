---
// src/components/EmergencyAndWhy.astro
---

<!-- Emergency Breakdown Banner -->
<section class="emergency-banner-section">
  <div class="container emergency-banner-container">
    <div class="emergency-content">
      <span class="emergency-badge">24/7 Rapid Response</span>
      <h2>Plant Down? Unplanned Outage?</h2>
      <p>We provide around-the-clock emergency electrical and mechanical breakdown support across South Africa. Minimize downtime with our rapid-dispatch engineering teams.</p>
    </div>
    <div class="emergency-action">
      <a href="tel:0795059510" class="btn-emergency">
        <span class="phone-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </span>
        <div class="phone-text">
          <small>Call Emergency Line</small>
          <strong>079 505 9510</strong>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- Workflow Section -->
<section class="workflow-section">
  <div class="container">
    <span class="hero-badge">Our Operational Process</span>
    <h2>Engineered for Precision & Speed</h2>
    <p class="section-subtitle">A transparent, rigorous 3-step methodology designed to eliminate unexpected failures.</p>
    
    <div class="workflow-grid">
      <div class="workflow-card" tabindex="0">
        <div class="workflow-number">01</div>
        <div class="workflow-content">
          <h3>Rapid Diagnosis & Inspection</h3>
          <p>We deploy advanced diagnostic tooling, performing mechanical teardowns, electrical insulation testing, and thermal imaging to isolate root causes.</p>
          <ul class="workflow-list">
            <li>✓ On-site or workshop fault-finding</li>
            <li>✓ Insulation resistance & surge testing</li>
            <li>✓ Detailed engineering assessment report</li>
          </ul>
        </div>
      </div>

      <div class="workflow-card" tabindex="0">
        <div class="workflow-number">02</div>
        <div class="workflow-content">
          <h3>Precision Overhaul & Repair</h3>
          <p>Equipment is routed to our workshop bays for complete copper rewinding, VPI treatment, or critical mechanical machining.</p>
          <ul class="workflow-list">
            <li>✓ Specialized copper winding & balancing</li>
            <li>✓ Transformer oil processing & rewinding</li>
            <li>✓ Switchgear and substation retrofits</li>
          </ul>
        </div>
      </div>

      <div class="workflow-card" tabindex="0">
        <div class="workflow-number">03</div>
        <div class="workflow-content">
          <h3>Rigorous Testing & Recommissioning</h3>
          <p>Units undergo extensive full-load and safety testing to ensure complete performance verification before recommissioning.</p>
          <ul class="workflow-list">
            <li>✓ Dynamic load & performance testing</li>
            <li>✓ Quality assurance & safety sign-off</li>
            <li>✓ Rapid dispatch & installation support</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why Choose Us Section -->
<section class="advantages-section">
  <div class="container">
    <span class="hero-badge">The Uncut Advantage</span>
    <h2>Why Heavy Industry Partners With Us</h2>
    <p class="section-subtitle">Decades of combined electro-mechanical expertise and rapid-response dispatch.</p>
    
    <div class="advantages-grid">
      <div class="advantage-card" tabindex="0">
        <h3>Rapid Breakdown Response</h3>
        <p>Dedicated engineering teams on standby 24/7 for emergency dispatch across South Africa.</p>
      </div>
      <div class="advantage-card" tabindex="0">
        <h3>Advanced Workshop Facility</h3>
        <p>Equipped with specialized heavy machinery, dynamic balancing pits, and automated coil-winding tools.</p>
      </div>
      <div class="advantage-card" tabindex="0">
        <h3>Strict Quality & Safety Aligned</h3>
        <p>All repair protocols execute in strict alignment with ISO 9001 standards.</p>
      </div>
      <div class="advantage-card" tabindex="0">
        <h3>Proven Turnaround Times</h3>
        <p>Streamlined diagnostic and repair pipelines that consistently deliver exceptional turnaround times.</p>
      </div>
      <div class="advantage-card" tabindex="0">
        <h3>Strategic Krugersdorp Hub</h3>
        <p>Centrally positioned in Krugersdorp for fast access to key industrial corridors and mining fields.</p>
      </div>
      <div class="advantage-card" tabindex="0">
        <h3>Experienced Engineering Team</h3>
        <p>Seasoned artisans, electrical technicians, and mechanical specialists with deep hands-on expertise.</p>
      </div>
    </div>
  </div>
</section>

<script>
  // Click-to-highlight state with orange border and glow effect
  document.querySelectorAll('.workflow-card, .advantage-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('.workflow-card, .advantage-card').forEach(c => c.classList.remove('is-clicked'));
      card.classList.toggle('is-clicked');
    });
  });
</script>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero-badge, .emergency-badge {
    display: inline-block;
    background-color: rgba(255, 127, 0, 0.15);
    color: #FF7F00;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 1rem;
    border: 1px solid rgba(255, 127, 0, 0.3);
  }

  .section-subtitle {
    color: #cccccc;
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }

  /* Emergency Banner Section with Top & Bottom 2px Borders */
  .emergency-banner-section {
    background-color: #161616;
    padding: 4rem 0;
    border-bottom: 2px solid #FF7F00;
  }

  .emergency-banner-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
    flex-wrap: wrap;
  }

  .emergency-content {
    flex: 1;
    min-width: 300px;
  }

  .emergency-content h2 {
    font-size: 2.25rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1rem;
  }

  .emergency-content p {
    color: #aaaaaa;
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .btn-emergency {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: #FF7F00;
    color: #000000;
    padding: 1rem 2rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 700;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }

  .btn-emergency:hover {
    background-color: #e67300;
    transform: translateY(-3px);
  }

  .phone-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.1);
    padding: 0.5rem;
    border-radius: 50%;
  }

  .phone-text small {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.8;
  }

  .phone-text strong {
    font-size: 1.25rem;
    letter-spacing: 0.5px;
  }

  /* Workflow Section */
  .workflow-section {
    background-color: #222222;
    padding: 5rem 0;
    text-align: center;
    border-bottom: 2px solid #FF7F00;
  }

  .workflow-section h2 {
    font-size: 2.25rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .workflow-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: left;
  }

  .workflow-card {
    background-color: #1a1a1a;
    border: 2px solid #333333;
    padding: 2.5rem 2rem;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .workflow-card:hover, .advantage-card:hover {
    transform: translateY(-5px);
    border-color: #FF7F00;
  }

  .workflow-card.is-clicked, .advantage-card.is-clicked {
    border-color: #FF7F00;
    box-shadow: 0 0 12px rgba(255, 127, 0, 0.4);
  }

  .workflow-number {
    font-size: 2rem;
    font-weight: 900;
    color: #FF7F00;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .workflow-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .workflow-card p {
    color: #aaaaaa;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }

  .workflow-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .workflow-list li {
    color: #cccccc;
    font-size: 0.9rem;
  }

  /* Advantages Section */
  .advantages-section {
    background-color: #1a1a1a;
    padding: 5rem 0;
    text-align: center;
    border-bottom: 2px solid #FF7F00;
  }

  .advantages-section h2 {
    font-size: 2.25rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .advantages-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: left;
  }

  .advantage-card {
    background-color: #222222;
    border: 2px solid #333333;
    padding: 2.5rem 2rem;
    border-radius: 6px;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .advantage-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
  }

  .advantage-card p {
    color: #aaaaaa;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .workflow-grid, .advantages-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .emergency-banner-container {
      flex-direction: column;
      align-items: flex-start;
    }

    .emergency-content h2, .workflow-section h2, .advantages-section h2 {
      font-size: 1.75rem;
    }
  }
</style>