<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-col footer-brand-col">
      <div class="footer-logo">
        <a href="/" class="logo-link">
          <img src="/uncut-logo-new.avif" alt="Uncut Electro Mechanical Engineering Logo" class="site-logo" width="220" height="220">
        </a>
      </div>
      <p class="footer-bio">
        Providing precision electro-mechanical engineering, 24/7 emergency breakdown support, and heavy industrial maintenance solutions to plants, mines, and utilities across South Africa.
      </p>
      <div class="footer-badge-wrapper">
        <span class="footer-iso-badge">ISO 9001 Aligned Standards</span>
      </div>
    </div>

    <div class="footer-col">
      <h3>Quick Links</h3>
      <ul class="footer-links">
        <li><a href="/#services">Core Services</a></li>
        <li><a href="/#workflow">Our Process</a></li>
        <li><a href="/#advantages">Why Choose Us</a></li>
        <li><a href="/#faq">FAQ</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Industries Served</h3>
      <ul class="footer-links">
        <li><a href="/#services">Mining & Minerals</a></li>
        <li><a href="/#services">Power Generation</a></li>
        <li><a href="/#services">Heavy Manufacturing</a></li>
        <li><a href="/#services">Municipal Infrastructure</a></li>
        <li><a href="/#services">Petrochemical Plants</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h3>Contact & Hub</h3>
      <ul class="footer-contact-list">
        <li>
          <span class="footer-icon">📍</span>
          <span>Central Workshop Hub:<br>30 Van Eck Street<br>Chamdor<br>Krugersdorp<br>1754<br>Gauteng<br>South Africa</span>
        </li>
        <li>
          <span class="footer-icon">📞</span>
          <span>Emergency Line:<br><a href="tel:0795059510">079 505 9510</a> (24/7 Active)</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-container">
      <p>&copy; 2026 Uncut Electro Mechanical Engineering. All Rights Reserved.</p>
      <p class="footer-credit">
        Website Designed & Developed by <a href="https://www.webdesignpros.co.za" target="_blank" rel="noopener">Web Design Pros</a>
      </p>
      <div class="footer-bottom-links">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms-of-service">Terms of Service</a>
      </div>
