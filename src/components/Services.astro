---
// src/components/Services.astro
const services = [
  { 
    title: "AC-DC Motor Rewinding", 
    desc: "Precision rebuilding, insulation upgrading, and testing for all industrial AC and DC motors.",
    image: "/ac-dc-motor-rewinding.avif" 
  },
  { 
    title: "Condition Monitoring", 
    desc: "Advanced diagnostic testing and continuous tracking to predict equipment failure before it happens.",
    image: "/condition-monitoring.avif" 
  },
  { 
    title: "Diesel Generators", 
    desc: "Reliable installation, maintenance, and load testing for critical backup power generator sets.",
    image: "/generator.avif" 
  },
  { 
    title: "Substations", 
    desc: "Complete setup, transformer upkeep, and high-voltage infrastructure management.",
    image: "/substation.avif" 
  },
  { 
    title: "Switchgears", 
    desc: "Routine servicing, retrofitting, and fault clearance for low- and high-voltage switchgear assemblies.",
    image: "/switchgear.avif" 
  },
  { 
    title: "Transformers", 
    desc: "Expert testing, oil filtration, maintenance, and installation of power transformers.",
    image: "/transformer.avif" 
  }
];

const capabilities = [
  { title: "Industrial Wiring", desc: "Heavy-duty electrical installations and upgrades for manufacturing plants." },
  { title: "Power Systems Analysis", desc: "Diagnostic assessments to optimize energy flow and prevent unexpected downtime." },
  { title: "Emergency Repairs", desc: "Rapid fault-finding and breakdown recovery available 24/7." },
  { title: "Compliance & Safety Audits", desc: "Rigorous testing to ensure full adherence to industrial safety standards." }
];
---

<section class="services-section" id="services">
  <div class="services-container">
    <h2>Our Core Services</h2>
    <p class="section-subtitle">Precision engineering solutions designed for heavy industry and critical power infrastructure.</p>

    <!-- 3x2 Desktop / 2x3 Mobile Grid for Core Services -->
    <div class="services-grid">
      {services.map(service => (
        <div class="service-card" tabindex="0">
          <div class="card-image-wrapper">
            <img 
              src={service.image} 
              alt={service.title} 
              width="800" 
              height="600"
              loading="lazy"
              class="service-img"
            />
          </div>
          <div class="card-content">
            <h3>{service.title}</h3>
            <p>{service.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Additional Capabilities Bullet List Section -->
    <div class="additional-capabilities">
      <h3>Specialized Industrial Capabilities</h3>
      <ul class="capabilities-list">
        {capabilities.map(item => (
          <li>
            <strong>{item.title}</strong> - {item.desc}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  // Adds an interactive click listener to toggle the orange border state
  document.querySelectorAll('.service-card').forEach(card => {
    card.addEventListener('click', () => {
      // Optional: remove highlight from other cards so only one stays highlighted at a time
      document.querySelectorAll('.service-card').forEach(c => c.classList.remove('is-clicked'));
      card.classList.toggle('is-clicked');
    });
  });
</script>

<style>
  .services-section {
    background-color: #1a1a1a;
    color: #ffffff;
    padding: 5rem 2rem;
    border-bottom: 2px solid #FF7F00;
  }

  .services-container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
  }

  .services-container h2 {
    font-size: 1.8rem;
    font-weight: 800;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .section-subtitle {
    color: #cccccc;
    margin-bottom: 3rem;
    font-size: 1.1rem;
  }

  /* Desktop Grid: 3 columns x 2 rows */
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .service-card {
    background-color: #222222;
    border: 2px solid #333333; /* Base border */
    border-top: 4px solid #FF7F00;
    border-radius: 6px;
    overflow: hidden;
    text-align: left;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .service-card:hover {
    transform: translateY(-5px);
    border-color: #FF7F00;
  }

  /* Highlight state when clicked */
  .service-card.is-clicked {
    border-color: #FF7F00;
    box-shadow: 0 0 12px rgba(255, 127, 0, 0.4);
  }

  .card-image-wrapper {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .service-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #ffffff;
  }

  .service-card p {
    color: #aaaaaa;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* Additional Capabilities Section Style */
  .additional-capabilities {
    background-color: #222222;
    border: 1px solid #333333;
    border-left: 4px solid #FF7F00;
    padding: 2.5rem;
    border-radius: 6px;
    text-align: left;
  }

  .additional-capabilities h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #FF7F00;
    text-transform: uppercase;
  }

  .capabilities-list {
    list-style-type: disc;
    padding-left: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .capabilities-list li {
    color: #cccccc;
    font-size: 1rem;
    line-height: 1.5;
  }

  .capabilities-list strong {
    color: #ffffff;
  }

  /* Mobile Grid: 2 columns x 3 rows */
  @media (max-width: 768px) {
    .services-container h2 {
      font-size: 1.4rem;
    }

    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      margin-bottom: 2.5rem;
    }

    .card-image-wrapper {
      height: 120px;
    }
    
    .card-content {
      padding: 1rem;
    }

    .service-card h3 {
      font-size: 0.95rem;
    }

    .service-card p {
      font-size: 0.8rem;
    }

    .additional-capabilities {
      padding: 1.5rem;
    }
  }
</style>