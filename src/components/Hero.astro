---
// Hero.astro
---

<section class="relative bg-[#222222] text-white mt-[60px] py-12 md:py-20 overflow-hidden" id="home">
  <!-- Grid shifted 60px to the right on Desktop using md:translate-x-[60px] -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center md:translate-x-[60px]">
    
    <!-- Hero Content Left (Centered on Mobile, Left-Aligned on Desktop) -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-6">
      
      <!-- H1 & Content Section -->
      <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight">
        UNCUT ELECTRO-MECHANICAL ENGINEERING
      </h1>
      
      <p class="text-gray-300 text-lg">
        Reliable, precision-driven electro-mechanical solutions powering industrial & commercial sectors.
      </p>

      <div class="space-y-2">
        <h2 class="text-xl md:text-2xl font-bold text-[#FF7F00]">
          EXPERT POWER SYSTEMS & INDUSTRIAL ENGINEERING
        </h2>
        <p class="text-gray-300">
          Providing high-voltage maintenance, transformer installation, and critical infrastructure support.
        </p>
      </div>

      <div class="space-y-2">
        <h3 class="text-lg md:text-xl font-bold text-white">
          24/7 RAPID RESPONSE & CERTIFIED COMPLIANCE
        </h3>
        <p class="text-gray-300">
          Licensed technicians deployed instantly across industrial sites to minimize downtime and eliminate electrical hazards.
        </p>
      </div>

      <!-- Hero Image (Mobile Only: Placed below text, above buttons) -->
      <div class="flex justify-center md:hidden my-2">
        <img 
          src="/high-voltage-transformer.avif" 
          alt="High Voltage Transformer - Uncut Electro" 
          class="rounded-lg shadow-2xl w-full max-w-lg object-cover border-2 border-[#FF7F00]" 
        />
      </div>

      <!-- Action Buttons (Narrower on Mobile) -->
      <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 pt-2 md:pt-4 w-full">
        <!-- Emergency Callout (Solid Orange + Black Text) -->
        <a 
          href="tel:0795059510" 
          class="bg-[#FF7F00] text-black text-center font-extrabold py-5 px-8 md:py-6 md:px-12 w-[85%] max-w-[280px] md:max-w-none md:w-auto md:min-w-[320px] rounded-lg uppercase no-underline text-lg md:text-xl shadow-lg hover:bg-[#e67300] transition-all flex items-center justify-center"
        >
          Emergency Callout
        </a>

        <!-- Our Services (Outline Button) -->
        <a 
          href="#services" 
          class="border-2 border-[#FFFFFF] text-[#FFFFFF] hover:bg-[#FF7F00] hover:text-black text-center font-bold py-5 px-8 md:py-6 md:px-12 w-[85%] max-w-[280px] md:max-w-none md:w-auto md:min-w-[320px] rounded-lg uppercase no-underline text-lg md:text-xl transition-all flex items-center justify-center"
        >
          Our Services
        </a>
      </div>

    </div>

    <!-- Hero Image Right (Desktop Only) -->
    <div class="hidden md:flex md:justify-center">
      <img 
        src="/high-voltage-transformer.avif" 
        alt="High Voltage Transformer - Uncut Electro" 
        class="rounded-lg shadow-2xl w-full max-w-lg object-cover border-2 border-[#FF7F00]" 
      />
    </div>

  </div>
</section>