---
// src/components/Hero.astro (Tailwind CSS Version)
---

<section class="bg-[#222222] text-white py-12 md:py-16 px-6 md:px-12 md:pl-[60px]" id="home">
  <!-- Grid container: 1 col on mobile, 2 cols on desktop -->
  <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
    
    <!-- 1. H1 Header Group -->
    <div class="order-1 md:col-start-1 md:row-start-1">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold mt-2 md:mt-0 mb-4 leading-tight uppercase text-center md:text-left">
        UNCUT ELECTRO-MECHANICAL ENGINEERING
      </h1>
      <p class="text-base sm:text-lg text-[#cccccc] mb-2 text-center md:text-left">
        Reliable, precision-driven electro-mechanical solutions powering industrial excellence.
      </p>
    </div>

    <!-- 2. Hero Image Container -->
    <div class="order-2 md:col-start-2 md:row-start-1 md:row-span-4 w-full flex justify-center items-center my-2 md:my-0">
      <img 
        src="/high-voltage-transformer.avif" 
        alt="High-Voltage Transformer - Uncut Electro-Mechanical Engineering" 
        width="626" 
        height="428"
        fetchpriority="high"
        loading="eager"
        class="w-full h-auto max-w-[626px] block rounded-lg border-2 border-[#FF7F00] shadow-xl"
      />
    </div>

    <!-- 3. H2 Group -->
    <div class="order-3 md:col-start-1 md:row-start-2 mb-2 text-center md:text-left">
      <h2 class="text-xl md:text-2xl font-bold text-[#FF7F00] mb-2 uppercase">
        Expert Power Systems & Industrial Engineering
      </h2>
      <p class="text-base md:text-lg text-[#cccccc]">
        Providing high-voltage maintenance, transformer installation, and critical infrastructure support for commercial and industrial sectors.
      </p>
    </div>

    <!-- 4. H3 Group -->
    <div class="order-4 md:col-start-1 md:row-start-3 mb-4 text-center md:text-left">
      <h3 class="text-lg md:text-xl font-semibold text-white mb-2 uppercase">
        24/7 Rapid Response & Certified Compliance
      </h3>
      <p class="text-base md:text-lg text-[#cccccc]">
        Licensed technicians deployed instantly across industrial sites to minimize downtime and eliminate electrical hazards.
      </p>
    </div>

    <!-- 5. Action Buttons -->
<div class="order-5 md:col-start-1 md:row-start-4 flex flex-col items-center md:items-start sm:flex-row gap-4 justify-center md:justify-start">
  
  <!-- Emergency Callout -->
  <a href="tel:0795059510" class="bg-[#FF7F00] text-black text-center font-extrabold py-5 px-8 md:py-6 md:px-12 w-full max-w-[340px] md:max-w-none md:w-auto md:min-w-[320px] rounded-lg uppercase no-underline text-lg md:text-xl shadow-lg hover:bg-[#e67300] transition-all flex items-center justify-center">
    Emergency Callout
  </a>

  <!-- Our Services -->
  <a href="#services" class="border-2 border-[#FF7F00] text-[#FF7F00] hover:bg-[#FF7F00] hover:text-black text-center font-bold py-5 px-8 md:py-6 md:px-12 w-full max-w-[340px] md:max-w-none md:w-auto md:min-w-[320px] rounded-lg uppercase no-underline text-lg md:text-xl transition-all flex items-center justify-center">
    Our Services
  </a>

</div>
      
      <!-- Our Services (Standard width on desktop, narrower on mobile, doubled py-8 height) -->
      <a href="#services" class="bg-transparent text-white border-2 border-white text-center font-bold py-8 px-6 md:px-8 w-[85%] max-w-[280px] md:max-w-none md:w-auto md:min-w-[200px] rounded uppercase no-underline text-base md:text-lg hover:bg-white hover:text-black transition-colors flex items-center justify-center">
        Our Services
      </a>
    </div>

  </div>
</section>