---
// src/components/Hero.astro (Tailwind CSS Version)
---

<section class="bg-[#222222] text-white py-16 px-8" id="home">
  <div class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center justify-between gap-12 text-center md:text-left">
    
    <div class="contents md:block md:flex-1 md:min-w-[300px]">
      <!-- Header Group -->
      <div class="order-1">
        <!-- mt-5 adds 20px top margin to lower the headline -->
        <h1 class="text-4xl font-extrabold mt-5 mb-4 leading-tight uppercase">
          UNCUT ELECTRO-MECHANICAL ENGINEERING
        </h1>
        <p class="text-lg text-[#cccccc] mb-5">
          Reliable, precision-driven electro-mechanical solutions powering industrial excellence.
        </p>
      </div>

      <!-- H2 Group -->
      <div class="order-3 mb-5">
        <h2 class="text-xl font-bold text-[#FF7F00] mb-1 uppercase">
          Expert Power Systems & Industrial Engineering
        </h2>
        <p class="text-lg text-[#cccccc]">
          Providing high-voltage maintenance, transformer installation, and critical infrastructure support for commercial and industrial sectors.
        </p>
      </div>

      <!-- H3 Group -->
      <div class="order-4 mb-7">
        <h3 class="text-base font-semibold text-white mb-1 uppercase">
          24/7 Rapid Response & Certified Compliance
        </h3>
        <p class="text-lg text-[#cccccc]">
          Licensed technicians deployed instantly across industrial sites to minimize downtime and eliminate electrical hazards.
        </p>
      </div>

      <!-- Action Buttons -->
      <div class="order-5 flex flex-wrap gap-4 justify-center md:justify-start">
        <!-- Increased padding (px-8 py-4), added min-w-[180px], text-center, & inline-block -->
        <a href="tel:0795059510" class="bg-[#FF7F00] text-black px-8 py-4 min-w-[180px] text-center font-bold rounded uppercase no-underline inline-block">
          Emergency Callout
        </a>
        <a href="#services" class="bg-transparent text-white border-2 border-white px-8 py-4 min-w-[180px] text-center font-bold rounded uppercase no-underline inline-block">
          Our Services
        </a>
      </div>
    </div>

    <!-- Image Container -->
    <div class="order-2 md:order-none w-full md:flex-1 md:min-w-[300px] mb-6 md:mb-0">
      <img 
        src="/high-voltage-transformer.avif" 
        alt="High-Voltage Transformer - Uncut Electro-Mechanical Engineering" 
        width="626" 
        height="428"
        fetchpriority="high"
        loading="eager"
        class="w-full h-auto block rounded-lg border-2 border-[#FF7F00]"
      />
    </div>

  </div>
</section>