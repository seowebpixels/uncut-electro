---
// Hero.astro
---

<section 
  class="relative bg-[#222222] text-white overflow-hidden" 
  id="home" 
  style="margin-top: 60px; padding-top: 30px; padding-bottom: 50px;"
>
  <!-- Grid container (Shifted 60px right on Desktop) -->
  <div 
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-2 gap-8 items-center"
    style="transform: var(--desktop-shift, none);"
  >
    
    <!-- Hero Content (Centered on Mobile, Left-Aligned on Desktop) -->
    <div class="flex flex-col items-center md:items-start text-center md:text-left gap-6">
      
      <!-- 1. H1 Heading & Text Block -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <h1 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight">
          UNCUT ELECTRO-MECHANICAL ENGINEERING
        </h1>
        
        <p class="text-gray-300 text-lg">
          Reliable, precision-driven electro-mechanical solutions powering industrial & commercial sectors.
        </p>

        <div class="space-y-2">
          <h2 class="text-xl md:text-2xl font-bold text-[#FF7F00]">
            EXPERT POWER SYSTEMS & INDUSTRIAL ENGINEERING
          </h2>
          <p class="text-gray-300">
            Providing high-voltage maintenance, transformer installation, and critical infrastructure support.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="text-lg md:text-xl font-bold text-white">
            24/7 RAPID RESPONSE & CERTIFIED COMPLIANCE
          </h3>
          <p class="text-gray-300">
            Licensed technicians deployed instantly across industrial sites to minimize downtime and eliminate electrical hazards.
          </p>
        </div>
      </div>

      <!-- 2. Hero Image (MOBILE ONLY: Placed below text, above buttons) -->
      <div class="block md:hidden my-2 w-full flex justify-center">
        <img 
          src="/high-voltage-transformer.avif" 
          alt="High Voltage Transformer - Uncut Electro" 
          class="rounded-lg shadow-2xl w-full max-w-sm object-cover" 
          style="border: 2px solid #FF7F00;"
        />
      </div>

      <!-- 3. Action Buttons (Narrower & Centered on Mobile) -->
      <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 pt-2 w-full">
        <!-- Emergency Callout (Solid Orange + Black Text) -->
        <a 
          href="tel:0795059510" 
          class="text-center font-extrabold py-5 px-8 md:py-6 md:px-12 w-[85%] max-w-[280px] md:max-w-none md:w-auto md:min-w-[320px] rounded-lg uppercase no-underline text-lg md:text-xl shadow-lg transition-all flex items-center justify-center"
          style="background-color: #FF7F00; color: #000000;"
        >
          Emergency Callout
        </a>

        <!-- Our Services (Outline Button) -->
        <a 
          href="#services" 
          class="border-2 border-[#FFFFFF] text-[#FFFFFF] hover:bg-[#FF7F00] hover:text-black text-center font-bold py-5 px-8 md:py-6 md:px-12 w-[85%] max-w-[280px] md:max-w-none md:w-auto md:min-w-[320px] rounded-lg uppercase no-underline text-lg md:text-xl transition-all flex items-center justify-center"
        >
          Our Services
        </a>
      </div>

    </div>

    <!-- Right Side Image (DESKTOP ONLY) -->
    <div class="hidden md:flex md:justify-center md:translate-x-[60px]">
      <img 
        src="/high-voltage-transformer.avif" 
        alt="High Voltage Transformer - Uncut Electro" 
        class="rounded-lg shadow-2xl w-full max-w-lg object-cover" 
        style="border: 2px solid #FF7F00;"
      />
    </div>

  </div>
</section>