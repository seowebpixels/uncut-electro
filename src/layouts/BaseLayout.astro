---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = "UNCUT ELECTRO-MECHANICAL ENGINEERING", description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Accepts page-specific SEO, Canonical, Open Graph, & JSON-LD Schema tags -->
    <slot name="head" />

    <style is:global>
      /* Global site resets and defaults */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        background-color: #222222;
        color: #ffffff;
        font-family: sans-serif;
      }

      /* Global rule for buttons to ensure black text as requested previously */
      button, .btn-primary {
        color: #000000;
      }
    </style>
  </head>

  <body>
    <Navbar />

    <main>
      <slot /> <!-- Your page components (Hero, Services, etc.) will render here -->
    </main>

    <Footer />
  </body>
</html>