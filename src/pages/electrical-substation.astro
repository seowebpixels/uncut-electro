---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Electrical Substation Services & High-Voltage Maintenance | Power Reliability"
  description="Ensure maximum grid stability, electrical safety, and asset longevity with expert substation testing, transformer diagnostic services, switchgear maintenance, and relay protection."
>
  <div style="background-color: #222222; color: #FFFFFF; min-height: 100vh;">

    <!-- 1. HERO SECTION (Starts 60px down from header) -->
    <section style="padding-top: 60px; padding-bottom: 48px;">
      <div style="max-width: 1152px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px;">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; align-items: start;">
          
          <!-- Left Column (H1 Content: 60px left padding) -->
          <div style="padding-left: 60px;">
            <span style="color: #9CA3AF; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; display: block; margin-bottom: 8px;">
              High-Voltage Infrastructure & Reliability
            </span>
            
            <!-- H1 Header: White -->
            <h1 style="color: #FFFFFF; font-size: 2.25rem; line-height: 1.2; font-weight: 700; margin-top: 8px; margin-bottom: 24px;">
              Electrical Substation Services
            </h1>
            
            <p style="color: #D1D5DB; font-size: 1.125rem; line-height: 1.625;">
              Ensure continuous power distribution, grid stability, and maximum personnel safety. Our specialized substation engineering and preventative maintenance solutions protect your high-voltage infrastructure against costly trips and catastrophic outages.
            </p>
            
            <!-- Schedule Button: 30px below paragraph -->
            <a href="#contact" style="display: inline-block; margin-top: 30px; background-color: #FF7F00; color: #222222; font-weight: 700; padding: 12px 24px; border-radius: 6px; text-decoration: none;">
              Schedule an Inspection
            </a>
          </div>
          
          <!-- Right Column (Image with 2px Orange Border) -->
          <div style="border-radius: 12px; overflow: hidden; border: 2px solid #FF7F00; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);">
            <img 
              src="/cs-electrical-substation.avif" 
              alt="Outdoor prefabricated high-voltage electrical substation enclosure" 
              style="width: 100%; height: auto; display: block; object-fit: cover;"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- 2. OVERVIEW SECTION (40px below image, Center Aligned, H2 in Orange) -->
    <section style="margin-top: 40px; padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 896px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <!-- H2 Header: Orange -->
        <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
          What are Electrical Substation Services?
        </h2>
        <div style="width: 80px; height: 4px; background-color: #FF7F00; margin-left: auto; margin-right: auto; border-radius: 2px; margin-bottom: 32px;"></div>
        
        <p style="color: #D1D5DB; font-size: 1.125rem; line-height: 1.625; margin-bottom: 32px; text-align: center; max-width: 768px;">
          <strong style="color: #FFFFFF;">Substation Services</strong> encompass the comprehensive engineering, testing, preventive maintenance, and lifecycle management of high and medium-voltage electrical sub-stations. By systematically inspecting transformers, switchgear, relays, and busbars, we identify electrical flaws before they trigger major power interruptions.
        </p>

        <div style="background-color: #2a2a2a; border-top: 4px solid #FF7F00; padding: 24px; border-radius: 8px; margin-top: 16px; margin-bottom: 16px; text-align: center; max-width: 768px;">
          <!-- H3 Header: White -->
          <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; text-align: center;">
            Engineering Power Reliability & System Protection
          </h3>
          <p style="color: #D1D5DB; line-height: 1.625; text-align: center; margin: 0;">
            Substation failures endanger facility personnel, destroy critical equipment, and halt entire plant operations. Our certified high-voltage technicians provide <strong>rigorous diagnostic testing, arc flash evaluations, and protection coordination audits</strong>—helping you comply with strict grid utility standards and maintain uninterrupted operations.
          </p>
        </div>

      </div>
    </section>

    <!-- 3. SOLUTIONS GRID SECTION (Center Aligned, H2 in Orange, H3 in White) -->
    <section style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 1152px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <div style="text-align: center; margin-bottom: 48px;">
          <!-- H2 Header: Orange -->
          <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
            Our Substation Solutions
          </h2>
          <p style="color: #D1D5DB; max-width: 672px; margin-left: auto; margin-right: auto; text-align: center;">
            We offer end-to-end high-voltage solutions to keep your industrial, commercial, and utility substation assets operating cleanly and safely.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; width: 100%;">
          
          <!-- Card 1 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              01
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Transformer Diagnostic Testing</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Thorough power transformer diagnostics including Dissolved Gas Analysis (DGA), transformer turns ratio (TTR), winding resistance, and power factor testing to catch internal dielectric faults early.
            </p>
          </div>

          <!-- Card 2 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              02
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">HV/MV Switchgear Inspection</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Mechanical and electrical integrity testing for vacuum, oil, and SF6 circuit breakers. We conduct contact resistance, insulation resistance, and trip timing analysis to guarantee reliable fault clearing.
            </p>
          </div>

          <!-- Card 3 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              03
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Protection Relay Calibration</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Precision secondary injection testing and calibration for electromechanical and digital protective relays. Ensure rapid, accurate isolation during overcurrent, ground fault, or differential conditions.
            </p>
          </div>

          <!-- Card 4 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              04
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Thermal & Partial Discharge Surveys</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Online acoustic and infrared thermography scans to detect hidden electrical tracking, loose bus connections, arc flash risks, and insulation degradation inside live enclosures without interrupting service.
            </p>
          </div>

          <!-- Card 5 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              05
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Grounding & Earth System Audits</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Full soil resistivity, fall-of-potential ground resistance testing, and step/touch potential risk assessments to protect personnel and prevent equipment damage during lightning strikes or ground faults.
            </p>
          </div>

          <!-- Card 6 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              06
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Busbar & Battery System Maintenance</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Comprehensive inspection of station DC battery banks, chargers, and main bus connections—ensuring critical backup control power is always ready during system failures.
            </p>
          </div>

          <!-- Card 7 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center; grid-column: 1 / -1;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              07
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; text-align: center;">Turnkey Commissioning & Retrofits</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; max-width: 768px; margin: 0;">
              Complete pre-commissioning testing, protection setting upgrades, microgrid automation, switchgear retrofitting, and emergency high-voltage restoration services designed to extend substation life and minimize operational downtime.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. BOTTOM CTA SECTION (Centered, H2 in Orange, Button 30px below paragraph) -->
    <section id="contact" style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 896px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <!-- H2 Header: Orange -->
        <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
          Ready to Secure Your Substation Reliability?
        </h2>
        <p style="color: #D1D5DB; font-size: 1.125rem; text-align: center; max-width: 672px; margin: 0;">
          Partner with our high-voltage electrical engineering team to implement a customized substation inspection and preventative maintenance schedule.
        </p>
        
        <!-- Get in Touch Button: 30px below paragraph -->
        <a href="/contact" style="display: inline-block; margin-top: 30px; background-color: #FF7F00; color: #222222; font-weight: 600; padding: 12px 32px; border-radius: 6px; text-decoration: none;">
          Get in Touch With Us
        </a>

      </div>
    </section>

  </div>
</BaseLayout>

