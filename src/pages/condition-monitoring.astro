// src/pages/condition-monitoring.astro
import Layout from '../layouts/Layout.astro'; // Adjust layout import based on your project structure
---

<Layout 
  title="Condition Monitoring & Predictive Maintenance | Machine Reliability Services"
  description="Maximize equipment uptime, prevent unexpected breakdowns, and reduce operational costs with our advanced condition monitoring, vibration analysis, and laser shaft alignment services."
>
  <div class="bg-[#222222] text-[#FFFFFF] min-h-screen">
    <!-- Hero Section -->
    <section class="py-16 md:py-24">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="text-[#FF7F00] text-sm font-semibold tracking-wider uppercase">Predictive Maintenance & Reliability</span>
            <h1 class="text-3xl md:text-5xl font-bold mt-2 mb-6 leading-tight text-[#FFFFFF]">
              Condition Monitoring Services
            </h1>
            <p class="text-lg text-gray-300 mb-8 leading-relaxed">
              Transition from costly reactive firefighting to proactive machinery healthcare. Our condition monitoring services provide real-time insights into machine health—stopping catastrophic failures before they happen.
            </p>
            <a href="#contact" class="inline-block bg-[#FF7F00] hover:bg-[#e06f00] text-[#222222] font-bold px-6 py-3 rounded-lg transition-colors">
              Schedule an Inspection
            </a>
          </div>
          <div class="rounded-xl overflow-hidden shadow-2xl border border-[#FF7F00]/30">
            <img 
              src="/condition-monitoring.jpg" 
              alt="Laser shaft alignment system on industrial machinery" 
              class="w-full h-auto object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Overview Section -->
    <section class="py-16 border-t border-neutral-800">
      <div class="container mx-auto px-4 max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-[#FF7F00] mb-4">What is Condition Monitoring?</h2>
          <div class="w-20 h-1 bg-[#FF7F00] mx-auto rounded"></div>
        </div>
        
        <p class="text-lg text-gray-300 leading-relaxed mb-6">
          <strong class="text-[#FF7F00]">Condition Monitoring (CM)</strong> is the continuous or periodic measurement of physical parameters—such as vibration, temperature, oil purity, and thermal profiles—in operating machinery. By tracking changes in these indicators over time, we can detect early-stage mechanical degradation long before functional failure occurs.
        </p>

        <div class="bg-[#2a2a2a] border-l-4 border-[#FF7F00] p-6 rounded-r-lg shadow-sm my-8">
          <h3 class="text-xl font-bold text-[#FF7F00] mb-2">How We Elevate Your Maintenance Strategy</h3>
          <p class="text-gray-300 leading-relaxed">
            Unplanned downtime drains capital, interrupts production, and leads to expensive secondary damage. We go beyond simply generating data logs—our certified reliability engineers deliver <strong>clear, actionable diagnosis</strong> and targeted recommendations. We help you extend machinery lifespan, optimize lube cycles, lower energy consumption, and plan maintenance during scheduled outages on <em>your</em> terms.
          </p>
        </div>
      </div>
    </section>

    <!-- Comprehensive Services Grid -->
    <section class="py-16 border-t border-neutral-800">
      <div class="container mx-auto px-4 max-w-6xl">
        <div class="text-center mb-16">
          <h2 class="text-3xl font-bold text-[#FF7F00] mb-4">Our Condition Monitoring Solutions</h2>
          <p class="text-gray-300 max-w-2xl mx-auto">
            We combine advanced Non-Destructive Testing (NDT) technologies with deep engineering expertise to safeguard critical plant assets.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          
          <!-- Integrated Condition Monitoring -->
          <div class="bg-[#2a2a2a] p-6 rounded-xl shadow-sm border border-neutral-800 hover:border-[#FF7F00]/50 transition-all">
            <div class="w-12 h-12 bg-[#FF7F00]/20 text-[#FF7F00] rounded-lg flex items-center justify-center font-bold text-xl mb-4">
              01
            </div>
            <h3 class="text-xl font-bold text-[#FF7F00] mb-3">Condition Monitoring Programs</h3>
            <p class="text-gray-300 text-sm leading-relaxed">
              Turnkey predictive maintenance management tailored to your plant criticality matrix. We set baseline parameters, perform regular route inspections, analyze trending data, and provide easy-to-read executive summary reports with clear repair priorities.
            </p>
          </div>

          <!-- Vibration Analysis -->
          <div class="bg-[#2a2a2a] p-6 rounded-xl shadow-sm border border-neutral-800 hover:border-[#FF7F00]/50 transition-all">
            <div class="w-12 h-12 bg-[#FF7F00]/20 text-[#FF7F00] rounded-lg flex items-center justify-center font-bold text-xl mb-4">
              02
            </div>
            <h3 class="text-xl font-bold text-[#FF7F00] mb-3">Vibration Analysis</h3>
            <p class="text-gray-300 text-sm leading-relaxed">
              Vibration is the heart rate of rotating equipment. Using FFT spectrum analysis, peakVue technology, and phase measurements, we pinpoint unbalance, misalignment, roller bearing defects, gear tooth wear, structural looseness, and resonance early.
            </p>
          </div>

          <!-- Shaft Alignment -->
          <div class="bg-[#2a2a2a] p-6 rounded-xl shadow-sm border border-neutral-800 hover:border-[#FF7F00]/50 transition-all">
            <div class="w-12 h-12 bg-[#FF7F00]/20 text-[#FF7F00] rounded-lg flex items-center justify-center font-bold text-xl mb-4">
              03
            </div>
            <h3 class="text-xl font-bold text-[#FF7F00] mb-3">Precision Shaft Alignment</h3>
            <p class="text-gray-300 text-sm leading-relaxed">
              Misalignment accounts for up to 50% of rotating machinery breakdowns. Utilizing state-of-the-art laser alignment tools, we restore horizontal, vertical, and angular alignment within OEM tolerances—reducing seal strain, power consumption, and bearing stress.
            </p>
          </div>

          <!-- Oil Analysis -->
          <div class="bg-[#2a2a2a] p-6 rounded-xl shadow-sm border border-neutral-800 hover:border-[#FF7F00]/50 transition-all">
            <div class="w-12 h-12 bg-[#FF7F00]/20 text-[#FF7F00] rounded-lg flex items-center justify-center font-bold text-xl mb-4">
              04
            </div>
            <h3 class="text-xl font-bold text-[#FF7F00] mb-3">Oil & Fluid Analysis</h3>
            <p class="text-gray-300 text-sm leading-relaxed">
              Oil is the liquid blood of your machine. Our laboratory fluid analysis tests for wear metals, particle counts, water contamination, viscosity index, and additive depletion—letting you assess component health and safely extend oil drain intervals.
            </p>
          </div>

          <!-- Infrared Thermography -->
          <div class="bg-[#2a2a2a] p-6 rounded-xl shadow-sm border border-neutral-800 hover:border-[#FF7F00]/50 transition-all">
            <div class="w-12 h-12 bg-[#FF7F00]/20 text-[#FF7F00] rounded-lg flex items-center justify-center font-bold text-xl mb-4">
              05
            </div>
            <h3 class="text-xl font-bold text-[#FF7F00] mb-3">Infrared Thermography</h3>
            <p class="text-gray-300 text-sm leading-relaxed">
              Non-contact thermal imaging detects invisible electrical phase imbalances, loose connections, overloaded circuits, friction hotspots, and refractory insulation leaks—preventing electrical fires and component burnouts.
            </p>
          </div>

          <!-- Machinery Lubrication -->
          <div class="bg-[#2a2a2a] p-6 rounded-xl shadow-sm border border-neutral-800 hover:border-[#FF7F00]/50 transition-all">
            <div class="w-12 h-12 bg-[#FF7F00]/20 text-[#FF7F00] rounded-lg flex items-center justify-center font-bold text-xl mb-4">
              06
            </div>
            <h3 class="text-xl font-bold text-[#FF7F00] mb-3">Machinery Lubrication</h3>
            <p class="text-gray-300 text-sm leading-relaxed">
              Improper lubrication causes over 70% of premature bearing failures. We design and audit best-in-class lubrication programs: establishing correct lubricant selection, precise regreasing volumes/frequencies, contamination control, and storage solutions.
            </p>
          </div>

          <!-- Failure Analysis -->
          <div class="bg-[#2a2a2a] p-6 rounded-xl shadow-sm border border-neutral-800 hover:border-[#FF7F00]/50 transition-all lg:col-span-3">
            <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
              <div class="w-12 h-12 bg-[#FF7F00]/20 text-[#FF7F00] rounded-lg flex-shrink-0 flex items-center justify-center font-bold text-xl">
                07
              </div>
              <div>
                <h3 class="text-xl font-bold text-[#FF7F00] mb-2">Root Cause Failure Analysis (RCFA)</h3>
                <p class="text-gray-300 text-sm leading-relaxed">
                  When a component fails, repairing it without identifying the underlying cause invites repeat failures. Our forensic engineering team conducts thorough Root Cause Failure Analysis—evaluating fractography, operational history, lubrication quality, and alignment logs to implement permanent corrective measures.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section id="contact" class="py-16 text-center border-t border-neutral-800">
      <div class="container mx-auto px-4 max-w-4xl">
        <h2 class="text-3xl font-bold text-[#FF7F00] mb-4">Ready to Eliminate Unplanned Downtime?</h2>
        <p class="text-gray-300 text-lg mb-8">
          Partner with our reliability specialists to implement a condition monitoring schedule customized to your plant's operational demands.
        </p>
        <a href="/contact" class="bg-[#FF7F00] text-[#222222] hover:bg-[#e06f00] font-semibold px-8 py-3 rounded-lg transition-colors inline-block">
          Get in Touch With Us
        </a>
      </div>
    </section>
  </div>
</Layout>