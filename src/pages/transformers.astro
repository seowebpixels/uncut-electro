---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Transformer Testing & Oil Diagnostics | High Voltage Maintenance Services"
  description="Comprehensive transformer testing & oil diagnostics: TTR tests, insulation resistance, Dissolved Gas Analysis (DGA), winding resistance, and OLTC maintenance."
>
  <div style="background-color: #222222; color: #FFFFFF; min-height: 100vh;">

    <!-- 1. HERO SECTION (Starts 60px down from header) -->
    <section style="padding-top: 60px; padding-bottom: 48px;">
      <div style="max-width: 1152px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px;">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; align-items: start;">
          
          <!-- Left Column (H1 Content: 60px left padding) -->
          <div style="padding-left: 60px;">
            <span style="color: #9CA3AF; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; display: block; margin-bottom: 8px;">
              Grid Stability & High Voltage Power
            </span>
            
            <!-- H1 Header: White -->
            <h1 style="color: #FFFFFF; font-size: 2.25rem; line-height: 1.2; font-weight: 700; margin-top: 8px; margin-bottom: 24px;">
              Transformer Testing & Maintenance
            </h1>
            
            <p style="color: #D1D5DB; font-size: 1.125rem; line-height: 1.625;">
              Protect the heart of your electrical distribution network. We provide complete transformer diagnostic testing, insulating oil analysis, winding resistance profiling, and preventative overhauls for power and distribution transformers.
            </p>
            
            <!-- Schedule Button: 30px below paragraph -->
            <a href="#contact" style="display: inline-block; margin-top: 30px; background-color: #FF7F00; color: #222222; font-weight: 700; padding: 12px 24px; border-radius: 6px; text-decoration: none;">
              Schedule an Inspection
            </a>
          </div>
          
          <!-- Right Column (Image with 2px Orange Border) -->
          <div style="border-radius: 12px; overflow: hidden; border: 2px solid #FF7F00; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);">
            <img 
              src="/cs-transformer.avif" 
              alt="Substation power transformer with high voltage bushings and cooling radiators" 
              style="width: 100%; height: auto; display: block; object-fit: cover;"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- 2. OVERVIEW SECTION (40px below image, Center Aligned, H2 in Orange) -->
    <section style="margin-top: 40px; padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 896px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <!-- H2 Header: Orange -->
        <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
          Maximizing Asset Life & Power Quality
        </h2>
        <div style="width: 80px; height: 4px; background-color: #FF7F00; margin-left: auto; margin-right: auto; border-radius: 2px; margin-bottom: 32px;"></div>
        
        <p style="color: #D1D5DB; font-size: 1.125rem; line-height: 1.625; margin-bottom: 32px; text-align: center; max-width: 768px;">
          Transformers represent one of the most substantial capital investments in any mining, municipal, or industrial site. Insulation degradation, oil contamination, or mechanical winding displacement can lead to explosive internal faults and months of unbudgeted downtime.
        </p>

        <div style="background-color: #2a2a2a; border-top: 4px solid #FF7F00; padding: 24px; border-radius: 8px; margin-top: 16px; margin-bottom: 16px; text-align: center; max-width: 768px;">
          <!-- H3 Header: White -->
          <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; text-align: center;">
            Proactive Condition Monitoring & Field Testing
          </h3>
          <p style="color: #D1D5DB; line-height: 1.625; text-align: center; margin: 0;">
            Our high-voltage specialists perform <strong>advanced electrical, chemical, and physical diagnostics</strong> to evaluate internal health. From Dissolved Gas Analysis (DGA) to Sweep Frequency Response, we identify latent insulation flaws long before they escalate into catastrophic grid failures.
          </p>
        </div>

      </div>
    </section>

    <!-- 3. SOLUTIONS GRID SECTION (Center Aligned, H2 in Orange, H3 in White) -->
    <section style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 1152px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <div style="text-align: center; margin-bottom: 48px;">
          <!-- H2 Header: Orange -->
          <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
            Our Transformer Testing & Maintenance Solutions
          </h2>
          <p style="color: #D1D5DB; max-width: 672px; margin-left: auto; margin-right: auto; text-align: center;">
            We offer end-to-end testing, fluid diagnostics, and mechanical overhauls designed according to international IEC and IEEE standards.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; width: 100%;">
          
          <!-- Card 1 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              01
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Transformer Turns Ratio (TTR) Testing</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              High-accuracy verification of primary-to-secondary voltage ratios, phase displacement, and winding polarity across all tap positions to detect shorted turns and tap changer misalignment.
            </p>
          </div>

          <!-- Card 2 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              02
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Insulation Resistance & PI Testing</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Megohm insulation resistance measurements combined with Polarization Index (PI) and Dielectric Absorption Ratio (DAR) profiling to evaluate winding insulation state and moisture ingress.
            </p>
          </div>

          <!-- Card 3 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              03
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Dissolved Gas Analysis (DGA) & Oil Diagnostics</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Laboratory dielectric breakdown voltage, moisture content, neutralization value, and gas chromatography testing to detect internal arcing, thermal hot spots, and cellulose degradation.
            </p>
          </div>

          <!-- Card 4 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              04
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Winding Resistance Measurements</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Micro-ohm resistance testing across all high-voltage and low-voltage windings to pinpoint loose internal bolted connections, broken copper strands, or worn tap changer contacts.
            </p>
          </div>

          <!-- Card 5 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              05
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Power Factor / Tan-Delta Dissipation</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              AC capacitance and dielectric loss testing across windings and high-voltage bushings to identify microscopic insulation aging and contamination prior to dielectric failure.
            </p>
          </div>

          <!-- Card 6 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              06
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Sweep Frequency Response Analysis (SFRA)</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Advanced frequency transfer signature profiling used to detect physical winding displacement, core distortion, or internal clamping failure following severe short-circuit faults.
            </p>
          </div>

          <!-- Card 7 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center; grid-column: 1 / -1;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              07
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; text-align: center;">On-Load Tap Changer (OLTC) & Bushing Servicing</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; max-width: 768px; margin: 0;">
              Full mechanical inspection and timing of On-Load Tap Changers, contact replacement, bushing porcelain/silicone cleaning, gasket replacement, oil purification, and vacuum dehydration services.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. BOTTOM CTA SECTION (Centered, H2 in Orange, Button 30px below paragraph) -->
    <section id="contact" style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 896px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <!-- H2 Header: Orange -->
        <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
          Ensure Your Transformer Reliability Today
        </h2>
        <p style="color: #D1D5DB; font-size: 1.125rem; text-align: center; max-width: 672px; margin: 0;">
          Contact our high-voltage engineering team today to schedule oil sampling, diagnostic testing, or comprehensive field servicing for your transformer fleet.
        </p>
        
        <!-- Get in Touch Button: 30px below paragraph -->
        <a href="/contact" style="display: inline-block; margin-top: 30px; background-color: #FF7F00; color: #222222; font-weight: 600; padding: 12px 32px; border-radius: 6px; text-decoration: none;">
          Get in Touch With Us
        </a>

      </div>
    </section>

  </div>
</BaseLayout>