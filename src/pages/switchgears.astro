---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Switchgear Testing & Circuit Breaker Maintenance | Electrical Safety Diagnostics"
  description="Comprehensive MV & HV switchgear testing: insulation resistance (Megger), Hi-Pot dielectric tests, contact resistance (Ductor), breaker timing, and interlock audits."
>
  <div style="background-color: #222222; color: #FFFFFF; min-height: 100vh;">

    <!-- 1. HERO SECTION (Starts 60px down from header) -->
    <section style="padding-top: 60px; padding-bottom: 48px;">
      <div style="max-width: 1152px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px;">
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 48px; align-items: start;">
          
          <!-- Left Column (H1 Content: 60px left padding) -->
          <div style="padding-left: 60px;">
            <span style="color: #9CA3AF; font-size: 14px; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; display: block; margin-bottom: 8px;">
              High Voltage Safety & Reliability
            </span>
            
            <!-- H1 Header: White -->
            <h1 style="color: #FFFFFF; font-size: 2.25rem; line-height: 1.2; font-weight: 700; margin-top: 8px; margin-bottom: 24px;">
              Switchgear Testing & Maintenance
            </h1>
            
            <p style="color: #D1D5DB; font-size: 1.125rem; line-height: 1.625;">
              Protect your electrical network against catastrophic arc flash incidents and unexpected power interruptions. We provide full dielectric, contact resistance, and mechanical diagnostic testing for medium and high-voltage switchgear installations.
            </p>
            
            <!-- Schedule Button: 30px below paragraph -->
            <a href="#contact" style="display: inline-block; margin-top: 30px; background-color: #FF7F00; color: #222222; font-weight: 700; padding: 12px 24px; border-radius: 6px; text-decoration: none;">
              Schedule an Inspection
            </a>
          </div>
          
          <!-- Right Column (Image with 2px Orange Border) -->
          <div style="border-radius: 12px; overflow: hidden; border: 2px solid #FF7F00; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);">
            <img 
              src="/cs-switchgear.avif" 
              alt="Industrial switchgear panel lineup in electrical room" 
              style="width: 100%; height: auto; display: block; object-fit: cover;"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- 2. OVERVIEW SECTION (40px below image, Center Aligned, H2 in Orange) -->
    <section style="margin-top: 40px; padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 896px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <!-- H2 Header: Orange -->
        <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
          Critical Protection for Electrical Infrastructure
        </h2>
        <div style="width: 80px; height: 4px; background-color: #FF7F00; margin-left: auto; margin-right: auto; border-radius: 2px; margin-bottom: 32px;"></div>
        
        <p style="color: #D1D5DB; font-size: 1.125rem; line-height: 1.625; margin-bottom: 32px; text-align: center; max-width: 768px;">
          Switchgears act as the central control and safety barrier for power distribution across industrial, mining, and municipal networks. Aging insulation, oxidized contacts, or sluggish trip coils can cause destructive arc flash events or catastrophic system downtime.
        </p>

        <div style="background-color: #2a2a2a; border-top: 4px solid #FF7F00; padding: 24px; border-radius: 8px; margin-top: 16px; margin-bottom: 16px; text-align: center; max-width: 768px;">
          <!-- H3 Header: White -->
          <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; text-align: center;">
            Comprehensive Standards-Compliant Diagnostic Audits
          </h3>
          <p style="color: #D1D5DB; line-height: 1.625; text-align: center; margin: 0;">
            Our specialist field engineers perform <strong>rigorous electrical, mechanical, and timing diagnostics</strong> on circuit breakers, busbars, and protective relays. We ensure your switchgear panels operate smoothly, trip accurately within millisecond tolerances, and satisfy international electrical safety codes.
          </p>
        </div>

      </div>
    </section>

    <!-- 3. SOLUTIONS GRID SECTION (Center Aligned, H2 in Orange, H3 in White) -->
    <section style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 1152px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <div style="text-align: center; margin-bottom: 48px;">
          <!-- H2 Header: Orange -->
          <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
            Our Switchgear Testing & Diagnostic Solutions
          </h2>
          <p style="color: #D1D5DB; max-width: 672px; margin-left: auto; margin-right: auto; text-align: center;">
            From high-potential dielectric stress testing to micro-ohm contact analysis, we evaluate every electrical and mechanical component in your switchboard lineup.
          </p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px; width: 100%;">
          
          <!-- Card 1 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              01
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Insulation Resistance (Megger) Testing</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Precision Megohm measurement across busbars, circuit breakers, and insulating barriers to detect moisture contamination, dirt accumulation, and early dielectric breakdown before energization.
            </p>
          </div>

          <!-- Card 2 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              02
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">High-Potential (Hi-Pot) Testing</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Controlled over-voltage stress testing applied for 60 seconds to prove the dielectric withstand capability of busbar insulation, phase separators, and vacuum/SF6 interrupters.
            </p>
          </div>

          <!-- Card 3 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              03
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Power Factor / Tan-Delta Analysis</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Advanced dissipation factor measurements that evaluate dielectric energy loss in solid and fluid insulation, pinpointing microscopic internal degradation and aging.
            </p>
          </div>

          <!-- Card 4 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              04
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Contact (Ductor) Resistance Testing</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Micro-ohm resistance testing across closed breaker contacts and bus connections to locate surface oxidation, contact pitting, or loose bolting that causes dangerous hot spots.
            </p>
          </div>

          <!-- Card 5 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              05
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Continuity & Protective Earthing Audits</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Verifies the low-resistance integrity of earth bar connections, panel earthing bonds, and control wiring circuits to guarantee safe ground-fault current paths.
            </p>
          </div>

          <!-- Card 6 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              06
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 12px; text-align: center;">Mechanical Interlock Verification</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; margin: 0;">
              Rigorous physical checks of mechanical and electrical safety interlocks to confirm proper switching sequences, preventing accidental racking or switching under load.
            </p>
          </div>

          <!-- Card 7 -->
          <div style="background-color: #2a2a2a; padding: 24px; border-radius: 12px; border: 1px solid #262626; text-align: center; display: flex; flex-direction: column; align-items: center; grid-column: 1 / -1;">
            <div style="width: 48px; height: 48px; background-color: rgba(255, 127, 0, 0.2); color: #FF7F00; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; margin-bottom: 16px;">
              07
            </div>
            <h3 style="color: #FFFFFF; font-size: 1.25rem; font-weight: 700; margin-bottom: 8px; text-align: center;">Breaker Timing & Trip/Close Coil Diagnostics</h3>
            <p style="color: #D1D5DB; font-size: 0.875rem; line-height: 1.625; text-align: center; max-width: 768px; margin: 0;">
              High-precision timing analysis measuring opening, closing, and total arc clearing speeds down to milliseconds, combined with trip and close coil current profiling to eliminate sluggish mechanism operation.
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. BOTTOM CTA SECTION (Centered, H2 in Orange, Button 30px below paragraph) -->
    <section id="contact" style="padding-top: 48px; padding-bottom: 48px; border-top: 1px solid #262626; text-align: center;">
      <div style="max-width: 896px; margin-left: auto; margin-right: auto; padding-left: 16px; padding-right: 16px; display: flex; flex-direction: column; align-items: center;">
        
        <!-- H2 Header: Orange -->
        <h2 style="color: #FF7F00; font-size: 1.875rem; font-weight: 700; margin-bottom: 16px; text-align: center;">
          Ensure Your Switchgears Perform Safely
        </h2>
        <p style="color: #D1D5DB; font-size: 1.125rem; text-align: center; max-width: 672px; margin: 0;">
          Contact our high-voltage electrical engineering team today to schedule switchgear testing, breaker timing, or preventative insulation audits.
        </p>
        
        <!-- Get in Touch Button: 30px below paragraph -->
        <a href="/contact" style="display: inline-block; margin-top: 30px; background-color: #FF7F00; color: #222222; font-weight: 600; padding: 12px 32px; border-radius: 6px; text-decoration: none;">
          Get in Touch With Us
        </a>

      </div>
    </section>

  </div>
</BaseLayout>
